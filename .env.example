# Copie este arquivo para .env e preencha. O .env NUNCA deve ser versionado.
# Todos os valores abaixo são exemplos seguros; nenhum é uma credencial real.

# --- Django -----------------------------------------------------------------
# Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ex.: https://autocheck.suaoficina.com.br (necessário em produção com HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Recife
DJANGO_LOG_LEVEL=INFO
# Duração da sessão em segundos (padrão: 10 horas)
# SESSION_COOKIE_AGE_SECONDS=36000

# --- Banco de dados ---------------------------------------------------------
# sqlite (desenvolvimento) ou postgresql (produção)
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
POSTGRES_DB=autocheck
POSTGRES_USER=autocheck
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# --- Arquivos privados (fotos, assinaturas, PDFs, logotipo) -----------------
PRIVATE_MEDIA_DIR=private_media
MAX_PHOTO_UPLOAD_MB=12

# --- E-mail (SMTP) ----------------------------------------------------------
# Sem EMAIL_HOST em desenvolvimento, os e-mails aparecem no console e NUNCA contam como enviados.
# Para testar um envio real, use uma conta sua (ex.: senha de app do provedor) ou um servidor SMTP de testes.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=AutoCheck <nao-responda@suaoficina.com.br>

# --- Regras de negócio ------------------------------------------------------
AUTOCHECK_RETENTION_MONTHS=6
# true SOMENTE atrás de um proxy (Nginx etc.) que define o X-Forwarded-For.
AUTOCHECK_TRUST_PROXY=false

# --- Integrações ------------------------------------------------------------
# BrasilAPI: gratuita e sem credencial (consulta de CNPJ).
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
BRASILAPI_TIMEOUT=8
# Sistema de gestão: integração preparada, sem API documentada. Deixe vazio; o sistema funciona sem ela.
MANAGEMENT_API_BASE_URL=
MANAGEMENT_API_TOKEN=
MANAGEMENT_API_TIMEOUT=10

# --- Demonstração -----------------------------------------------------------
# Senha da conta demo@example.com criada por `python manage.py seed_demo`.
# Opcional: sem ela, o comando pergunta a senha ou orienta a usar `changepassword`.
# AUTOCHECK_DEMO_PASSWORD=
